{
  "name": "amen-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Amen City: a 3D church community game set in real Lagos. Runs in the browser.",
  "scripts": {
    "dev": "concurrently -k -n web,server \"vite\" \"node server/index.js\"",
